# Optional overrides for factory addresses (public values only — never put keys here).
# After a live deploy, web/src/deployments.json is updated automatically. Leave these
# empty to use that file. Empty in both places = "not deployed yet" in the dapp.
VITE_FACTORY_MAINNET=
VITE_FACTORY_BASE=
VITE_FACTORY_ANVIL=
VITE_USDC_ANVIL=
VITE_WETH_ANVIL=
# Optional custom RPCs (public endpoints are used otherwise)
VITE_MAINNET_RPC=
VITE_BASE_RPC=
VITE_ANVIL_RPC=http://127.0.0.1:8545
